<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane maxHeight="Infinity" maxWidth="Infinity"
            HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS"
            xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1">

    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                    styleClass="task-page-scroll">
            <VBox spacing="14" styleClass="task-page-root" maxWidth="Infinity">

                <VBox styleClass="content-card">
                    <HBox alignment="CENTER_LEFT" maxWidth="Infinity" styleClass="header-blue">
                        <Label style="-fx-font-weight: bold; -fx-text-fill: white; -fx-font-size: 13px;"
                               text="Hospital Heal Routine" />
                    </HBox>
                    <VBox spacing="12" styleClass="task-section-inner">
                        <Label styleClass="task-card-description"
                               text="Automatically manages wounded troops through the verified Field hospital shortcut. City hospital entry remains unavailable pending verification." wrapText="true" />
                        
                        <Separator style="-fx-opacity: 0.25;" />

                        <CheckBox fx:id="checkBoxHospitalHeal" graphicTextGap="6.0"
                                  mnemonicParsing="false" text="Enable Hospital Heal Routine" />

                        <CheckBox fx:id="checkBoxFieldHospital" graphicTextGap="6.0"
                                  mnemonicParsing="false" text="Process Field Hospital shortcut icon (from World screen)" />

                        <CheckBox fx:id="checkBoxCityHospital" disable="true" graphicTextGap="6.0"
                                  mnemonicParsing="false" text="City Hospital building (Unavailable: awaiting verification)" />

                        <CheckBox fx:id="checkBoxUseSpeedup" disable="true" graphicTextGap="6.0"
                                  mnemonicParsing="false" text="Allow using healing speedups (Default: Disabled for safety)" />

                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label styleClass="task-field-label" text="Warn if Wait Exceeds Minutes:" />
                            <TextField fx:id="textFieldMaxWaitMinutes" prefWidth="80.0" text="30" />
                        </HBox>
                    </VBox>
                </VBox>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
